# Hypervisor 1 of the Snout lab (bash misc/bootstrap-hypervisor.sh --env misc/lab/hv1.env)
# Set UPLINK_IF to the name of the lab vNIC (see "ip -br link").
UPLINK_IF=
ADDRESS=172.31.0.11/24
HOST_NAME=snout-hv1
RR_IP=172.31.0.10
NEIGH1_IP=172.31.0.12
NEIGH2_IP=172.31.0.13
ASN=65000
# VLANs on br0; VNI = VLAN + VNI_OFFSET (100 -> 10100, 200 -> 10200).
# Items may also be "vlan:vni" for an explicit mapping.
SEGMENTS=100,200
VNI_OFFSET=10000
# Optional: second NIC added to br0 as a trunk of the SEGMENTS VLANs.
#TRUNK_IF=
